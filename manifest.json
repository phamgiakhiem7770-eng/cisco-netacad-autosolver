{
  "manifest_version": 3,
  "name": "NetAcad Gemini Helper",
  "version": "1.2",
  "description": "Automatically finds Cisco NetAcad quiz answers using Gemini",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netacad.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/netacad-autosolver.png",
      "32": "icons/netacad-autosolver.png",
      "48": "icons/netacad-autosolver.png",
      "128": "icons/netacad-autosolver.png"
    }
  },
  "icons": {
    "16": "icons/netacad-autosolver.png",
    "32": "icons/netacad-autosolver.png",
    "48": "icons/netacad-autosolver.png",
    "128": "icons/netacad-autosolver.png"
  }
}