{
  "manifest_version": 3,
  "name": "NetAcad Gemini Helper",
  "version": "1.2",
  "description": "Automatically finds Cisco NetAcad quiz answers using Gemini",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netacad.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}