{
  "manifest_version": 3,
  "name": "NetAcad Gemini Helper",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.netacad.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.netacad.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}